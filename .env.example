# QueryNest frontend
#
# Copy to .env.local for local overrides:
#   cp .env.example .env.local
#
# Next.js inlines NEXT_PUBLIC_* into the browser bundle at build time.
# `npm run dev` reads a change after a restart. `npm run build` bakes in
# the value from the environment that runs the build.
#
# This value is the REST origin (scheme + host + port, no path). The research
# WebSocket is not a separate variable: http becomes ws, and https becomes wss.
# Leave it unset, or keep the default, when the API is on localhost:8000
# (local uvicorn and the query-nest-infra Compose stack both publish that port
# to the host, which is where the browser runs).

NEXT_PUBLIC_API_URL=http://localhost:8000
